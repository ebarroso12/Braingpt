# Exemplo do backend Evolution OPCIONAL. Para a ponte atual, use deploy/relay.env.example.
# Preencher SOMENTE no ambiente privado. Este exemplo não inicia sem configuração.
EVOLUTION_BASE_URL=https://evo.example
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=braingpt-test
EVOLUTION_WEBHOOK_SECRET=
SENDER_HASH_SALT=
ALLOWED_PHONE_HASHES=
DATABASE_PATH=./data/braingpt.sqlite
HOST=127.0.0.1
PORT=3030
TIMEZONE=America/Sao_Paulo
RATE_LIMIT_PER_MINUTE=20
EVOLUTION_TIMEOUT_MS=10000
# transport não chama modelo; openai exige as quatro variáveis privadas abaixo.
AGENT_MODE=transport
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=20000
# Chave AES-256-GCM: 32 bytes aleatórios em base64, distinta das chaves de API.
STATE_ENCRYPTION_KEY=
