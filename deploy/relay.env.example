# Configuração PRIVADA do novo motor, usando a ponte já instalada.
# Não copiar valores de arquivos do OpenClaw; reutilizar a chave OpenAI pelo secret manager.
RELAY_ROOT=/opt/codex-whatsapp-relay
RELAY_NAMESPACE=main
DATABASE_PATH=/var/lib/braingpt/braingpt.sqlite
SENDER_HASH_SALT=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_MS=20000
STATE_ENCRYPTION_KEY=
TIMEZONE=America/Sao_Paulo
RATE_LIMIT_PER_MINUTE=20
RELAY_SEND_TIMEOUT_MS=10000
# A allowlist vem da configuração atual da ponte Codex.
# Não há EVOLUTION_BASE_URL, EVOLUTION_API_KEY ou QR novo nesse modo.
